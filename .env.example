# 火山引擎 TTS 凭证（CLI 和 webapp 共用）
VOLCENGINE_APPID=your_appid_here
VOLCENGINE_ACCESS_TOKEN=your_access_token_here
VOLCENGINE_CLUSTER=volcano_icl
VOLCENGINE_VOICE_TYPE=your_voice_type_id_here

# Web 应用专用：访问码（逗号分隔，启动时若为空进程拒绝启动）
ACCESS_CODES=invite-code-1,invite-code-2

# 内容/资源限制
MAX_TOTAL_CHARS=20000
MAX_UPLOAD_BYTES=5242880
MAX_SEGMENTS=200
MAX_TEXT_CHARS=300
MAX_CONCURRENT_JOBS=2

# 任务生命周期
JOB_TTL_SECONDS=3600
JOB_MAX_RUNTIME_SECONDS=1800

# 速率限制（每 IP 每分钟提交任务次数）
RATE_LIMIT_PER_MINUTE=3

# CLI 选用：覆盖 inputs/ 目录自动查找
# INPUTS_DIR=/absolute/path/to/inputs
